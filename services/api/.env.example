SERVICE_NAME=campaign-api
ENVIRONMENT=local
LOG_LEVEL=INFO
API_PREFIX=/api/v1
MAX_PAGE_SIZE=100
DYNAMODB_TABLE_NAME=campaign-agent-local
QUEUE_BACKEND=memory
AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.REGION.amazonaws.com/ACCOUNT_ID/QUEUE_NAME
SQS_REQUEST_TIMEOUT_SECONDS=10
# LocalStack/testing only; leave unset outside local/test environments.
# SQS_ENDPOINT_URL=http://localhost:4566
