ENVIRONMENT=local
AWS_REGION=us-east-1
SQS_QUEUE_URL=https://sqs.REGION.amazonaws.com/ACCOUNT_ID/QUEUE_NAME
DYNAMODB_TABLE_NAME=campaign-agent-local
# S3 bucket for generated artifacts (IMAGE/AUDIO/VIDEO/FINAL_PACKAGE). Required
# outside local/test -- see main.py::build_consumer, which now refuses to
# silently fall back to mock providers when this (or the image/voice config
# below) is entirely unset outside local/test.
CAMPAIGN_ARTIFACT_BUCKET=
SQS_WAIT_TIME_SECONDS=20
SQS_BATCH_SIZE=1
SQS_VISIBILITY_TIMEOUT_SECONDS=180
WORKER_HEARTBEAT_INTERVAL_SECONDS=60
WORKER_MAX_DELIVERY_ATTEMPTS=4
WORKER_SHUTDOWN_GRACE_SECONDS=30
# AWS SQS boto3 client timeouts and the local receive-retry backoff used when
# the queue itself is temporarily unreachable (see consumer/sqs_consumer.py).
AWS_SQS_CONNECT_TIMEOUT_SECONDS=10
AWS_SQS_READ_TIMEOUT_SECONDS=70
SQS_RECEIVE_RETRY_INITIAL_BACKOFF_SECONDS=2
SQS_RECEIVE_RETRY_MAX_BACKOFF_SECONDS=30
# Worker service identity and the health/metrics HTTP server port
# (/health/live, /health/ready, /metrics) -- see health.py.
WORKER_SERVICE_NAME=campaign-worker
WORKER_HEALTH_PORT=8080
VIDEO_RENDER_TIMEOUT_SECONDS=1200
VIDEO_MAX_DOWNLOAD_BYTES=50000000
# Video renderer: ffmpeg is the default/fallback (Ken Burns slideshow).
# hyperframes is the premium, opt-in renderer -- open-source heygen-com/hyperframes
# CLI, run entirely locally via npx (headless Chrome + FFmpeg, no HeyGen account/OAuth).
# Requires Node.js 22+ and npx on PATH; see config.py::validate_video_pipeline.
VIDEO_RENDERER=hyperframes
NPX_PATH=npx
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Final package (FINAL_PACKAGE artifact) maximum size.
PACKAGE_MAX_BYTES=52428800
# Local/dev fallback music bed for the CINEMATIC_TEXT_AD video style only --
# NOT the production music-selection strategy. Leave unset unless testing
# CINEMATIC_TEXT_AD locally. See video/audio_plan.py and video/audio_mix.py.
CINEMATIC_MUSIC_PATH=
# Local/dev SFX asset directory for CINEMATIC_TEXT_AD transition/brand cues --
# see video/audio_cue_library.py. Optional: unset means every AudioCueType is
# skipped gracefully (SFX are an accent, never required for a render).
SFX_LIBRARY_PATH=
# LocalStack/testing only; leave unset outside local/test environments.
# AWS_ENDPOINT_URL=http://localhost:4566

# Image pipeline: generative (Cloudflare Workers AI / FLUX) is the primary
# path; stock is Pexels-only, for testing/debug. See
# config.py::validate_image_pipeline for required combinations.
IMAGE_PROVIDER_MODE=generative
IMAGE_PEXELS_FALLBACK_ENABLED=true
PEXELS_API_KEY=
BEDROCK_IMAGE_QUERY_MODEL_ID=
# AI creative-plan generation (see graph/creative_plan_provider.py). Optional --
# unset means the deterministic CreativeVideoPlan generator is used directly.
# Any Bedrock failure/invalid-response already falls back to it automatically.
BEDROCK_CREATIVE_PLAN_MODEL_ID=
PEXELS_CANDIDATE_COUNT=15
IMAGE_HTTP_TIMEOUT_SECONDS=20
IMAGE_MAX_DOWNLOAD_BYTES=25000000
# Cloudflare Workers AI (FLUX) -- never put a real token here. Token needs
# the "Workers AI Read/Edit" account permission.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_FLUX_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_FLUX_STEPS=4
# Descriptive-only metadata (flux-1-schnell has no aspect-ratio request
# parameter) -- used for cache-fingerprint/metadata parity with the stock
# pipeline only, never sent to Cloudflare's API.
CLOUDFLARE_FLUX_ASPECT_RATIO=1:1
CLOUDFLARE_HTTP_TIMEOUT_SECONDS=30
# Stability AI (Stable Diffusion 3.5 Large) -- retained, unused, for
# rollback only. Not read by main.py::build_consumer any more; never put a
# real key here.
STABILITY_API_KEY=
STABILITY_IMAGE_MODEL=sd3.5-large
STABILITY_IMAGE_ASPECT_RATIO=9:16
STABILITY_IMAGE_OUTPUT_FORMAT=jpeg
STABILITY_HTTP_TIMEOUT_SECONDS=60
# Polly voiceover synthesis. POLLY_VOICE_ID unset means Polly's own default
# voice for the engine is used; POLLY_ENGINE must be one of standard, neural,
# long-form, generative (see config.py::validate_voice_pipeline).
POLLY_VOICE_ID=
POLLY_ENGINE=neural
# Polly boto3 client timeouts -- isolated from the shared AWS client Config
# used for DynamoDB/Bedrock/S3, since a short narration synthesis call was
# observed to exceed a too-tight shared read_timeout in production
# (PROVIDER_TIMEOUT).
AWS_POLLY_CONNECT_TIMEOUT_SECONDS=10
AWS_POLLY_READ_TIMEOUT_SECONDS=60
# ffmpeg loudness-normalization timeout applied after Polly synthesis (see
# audio/normalizer.py). Voiceover generation hard-requires ffmpeg on PATH.
AUDIO_NORMALIZE_TIMEOUT_SECONDS=30
