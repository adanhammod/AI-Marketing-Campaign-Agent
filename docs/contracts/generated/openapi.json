{
  "components": {
    "schemas": {
      "ApprovalRecord": {
        "additionalProperties": false,
        "properties": {
          "actor": {
            "default": "DEMO_USER",
            "pattern": "^DEMO_USER$",
            "title": "Actor",
            "type": "string"
          },
          "approval_id": {
            "format": "uuid",
            "title": "Approval Id",
            "type": "string"
          },
          "approved_at": {
            "format": "date-time",
            "title": "Approved At",
            "type": "string"
          },
          "campaign_id": {
            "format": "uuid",
            "title": "Campaign Id",
            "type": "string"
          },
          "campaign_version": {
            "minimum": 1.0,
            "title": "Campaign Version",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "decision": {
            "default": "APPROVED",
            "pattern": "^APPROVED$",
            "title": "Decision",
            "type": "string"
          },
          "lock_version": {
            "default": 1,
            "minimum": 1.0,
            "title": "Lock Version",
            "type": "integer"
          },
          "manifest_checksum": {
            "pattern": "^[0-9a-f]{64}$",
            "title": "Manifest Checksum",
            "type": "string"
          },
          "note": {
            "anyOf": [
              {
                "maxLength": 500,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Note"
          }
        },
        "required": [
          "approval_id",
          "campaign_id",
          "campaign_version",
          "approved_at",
          "manifest_checksum",
          "created_at"
        ],
        "title": "ApprovalRecord",
        "type": "object"
      },
      "ArtifactType": {
        "enum": [
          "REFERENCE_IMAGE",
          "IMAGE",
          "AUDIO",
          "VIDEO",
          "STORYBOARD",
          "MANIFEST",
          "REVIEW_PACKAGE",
          "FINAL_PACKAGE",
          "PROVIDER_DIAGNOSTIC"
